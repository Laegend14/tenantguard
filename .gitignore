# ==============================================================================
# TenantGuard NYC - Git Ignore Rules
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/coverage
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Environment & Secrets (Never commit credentials)
.env*
!.env.example

# Local Data Vault & Storage
/.data/

# Scripts & Utility Tools (not needed for running the app)
/scripts/

# Markdown Documentation not needed for running the app (Preserve README.md)
*.md
!README.md
AGENTS.md
CLAUDE.md
frontend.md

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
