# ==============================================================================
# TenantGuard (NYC Edition) - Environment Configuration Template
# Copy this file to .env.local and populate with your own API credentials
# ==============================================================================

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Hugging Face AI Engine (https://huggingface.co)
HF_TOKEN=hf_your_hugging_face_token

# Firebase & Firestore Realtime History (https://firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Stripe Payments & Checkout (Test Mode - https://stripe.com)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Resend Certified Legal Mail (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TEST_RECIPIENT=your-email@example.com

# NYC Open Data - HPD Housing Maintenance Code (https://data.cityofnewyork.us)
NYC_HPD_APP_TOKEN=your_nyc_opendata_app_token
NYC_HPD_API_KEY_ID=your_nyc_api_key_id
NYC_HPD_API_KEY=your_nyc_api_key
NYC_HPD_SECRET_ID=your_nyc_secret_id
